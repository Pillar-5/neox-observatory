# NeoX Observatory Configuration
# Copy to .env and adjust values

# Neo X RPC URL (use mainnet-5 for Anti-MEV support, others for general use)
NEOX_RPC_URL=https://mainnet-1.rpc.banelabs.org

# Network name (mainnet or testnet)
NEOX_NETWORK=mainnet

# Neo N3 RPC URL (for bridge correlation, optional)
NEO_N3_RPC_URL=

# SQLite database path
DATABASE_PATH=./data/neox-observatory.db

# API server port
API_PORT=3000

# Web dashboard port
WEB_PORT=5173

# Indexer start block (0 = from genesis, negative = recent blocks from head)
INDEXER_START_BLOCK=-1000

# Indexer block window (how many blocks to process per batch)
INDEXER_BLOCK_WINDOW=100

# Log level (debug, info, warn, error)
LOG_LEVEL=info